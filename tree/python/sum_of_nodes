class Node:
    def __init__(self, data):
        self.data = data
        self.left = None
        self.right = None
    def sum_nodes(self,root):
        if root is None:
            return 0
        return root.data+self.sum_nodes(root.left)+self.sum_nodes(root.right)
# create nodes

root = Node(1)
root.left = Node(2)
root.right = Node(3)
print("Sum of all nodes in the binary tree:", root.sum_nodes(root))

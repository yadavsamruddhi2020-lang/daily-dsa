class Node:
    def __init__(self, data):
        self.data = data
        self.left = None
        self.right = None
    def count_nodes(self,root):
        if root is None:
            return 0
        return 1+ self.count_nodes(root.left)+self.count_nodes(root.right)
# create nodes
root = Node(1)
root.left = Node(2)
root.right = Node(3)    
print("Number of nodes in the binary tree:", root.count_nodes(root))

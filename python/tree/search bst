class Node:
    def __init__(self,data):
        self.data=data
        self.left=None
        self.right=None
def search(root,key):
    if root is None:
        return False
    if root.data==key:
        return True
    return search(root.left,key) or search(root.right,key)

root=Node(1)
root.left=Node(2)
